#!/bin/bash

# network.config - Default configuration for the Fabric test network

# Docker socket path
export DOCKER_SOCK="${DOCKER_HOST:-/var/run/docker.sock}"

# Channel name
CHANNEL_NAME="mychannel"

# Chaincode parameters
CC_NAME="v2v"
CC_SRC_PATH="../chaincode/v2v/javascript"
CC_SRC_LANGUAGE="javascript"
CC_VERSION="1.0"
CC_SEQUENCE="auto"
CC_INIT_FCN="NA"
CC_END_POLICY="OR('Org1MSP.peer','Org2MSP.peer')"
CC_COLL_CONFIG="NA"

# Timeouts
MAX_RETRY="5"
CLI_DELAY="3"

# Database
DATABASE="leveldb"

# Crypto mode
CRYPTO="Certificate Authorities"

# Verbose
VERBOSE="false"
